(wire (pts (xy 273.0500 139.7000) (xy 278.1300 139.7000)) (stroke (width 0) (type default)) (uuid "a5458f8a-8e1a-47a8-970e-1dd3b1d63ff7"))
(global_label "BT_STATE_AUX" (shape input) (at 278.1300 139.7000 0) (effects (font (size 1 1)) (justify left)) (uuid "c0e206ab-983a-40e7-9bfa-9d111bdb2c3b"))
(text "J22 pins match the module labels from EN end: EN, VCC, GND, TXD, RXD, STATE.\nNormal four-wire harness uses pins 2-5 only. J22 is a cabled connector, not a module socket.\nVCC is 5 V; every signal is 3.3 V. The Arduino Uno divider is not needed for Teensy 4.1.\nModule TXD -> Teensy GPIO0/RX1 (U7 pad2); module RXD <- GPIO1/TX1 (U7 pad3)." (at 25.4 185.42 0) (effects (font (size 1.4 1.4)) (justify left)) (uuid "2f59b81d-005a-485c-ae36-e215ef33dc6a"))
(text "R65 and R66 are DO NOT POPULATE. GPIO2 (U7 pad4) and GPIO32 (pad24) are reserved.\nThe photographed module has only four header pins fitted; EN/STATE labels do not establish functionality.\nLeave J22 pins1/6 unwired and GPIO2/32 as inputs with no pull until the exact module is verified.\nEN behavior varies by module and is not assumed to be a reliable power-disable control." (at 25.4 218.44 0) (effects (font (size 1.4 1.4)) (justify left)) (uuid "d7324122-4ae5-4f58-be51-7818795c4234"))
(text "Firmware must use Serial1 at the module's configured baud rate. USB Serial is separate.\nNo firmware or radio link has been tested. Keep the external antenna clear of metal and motor wiring." (at 25.4 248.92 0) (effects (font (size 1.4 1.4)) (justify left)) (uuid "fb937382-1e69-44f9-bb14-4b886f42c3a8"))
